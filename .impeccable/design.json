  "narrative": {
    "northStar": "Destino Viana",
    "overview": "Uma linguagem de atlas e ensaio fotográfico apresenta Viana como um destino a descobrir. Superfícies claras, azul profundo e fotografias grandes dão espaço à marca original e à informação do evento.\n\nA tipografia editorial organiza os capítulos; a interface permanece direta e legível. O movimento localiza o município e acompanha a passagem entre capítulos, sem bloquear o scroll ou exigir animação para acessar conteúdo.",
    "keyCharacteristics": [
      "Abertura cartográfica com origem identificada.",
      "Capítulos fotográficos com espaço para leitura.",
      "Marca original preservada e ações reconhecíveis."
    ],
    "rules": [
      {
        "name": "The Legibility Rule",
        "body": "Preserve o texto secundário sólido nas superfícies claras e avalie cada combinação de texto e fundo antes de reduzir sua opacidade.",
        "section": "colors"
      },
      {
        "name": "The Motion Rule",
        "body": "Preserve a informação e as ações acessíveis durante o movimento; com movimento reduzido, mostre o destino estático e retire deslocamentos decorativos.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preservar as imagens originais da marca e a data confirmada.",
      "Do manter foco visível e controles com espaço de toque.",
      "Do usar fotografias com alternativas e créditos existentes.",
      "Do oferecer o destino estático quando houver preferência por movimento reduzido."
    ],
    "donts": [
      "Don't usar animação como espera obrigatória para conteúdo ou ações.",
      "Don't exigir hover para ler informações ou operar fluxos.",
      "Don't apresentar o pin municipal como endereço do evento ou rota de transporte."
    ]
  }
}
